+def get(client, rid):
+    response = client.get(f'/v1/traces/{rid}')
+    assert response.status_code == 200, response.text
+    assert set(response.json()) == {'success', 'code', 'message', 'data'}
+    assert response.json()['data']['request_id'] == rid
+    return response.json()['data']
