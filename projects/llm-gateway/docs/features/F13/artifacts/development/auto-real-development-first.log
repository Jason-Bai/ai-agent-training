    def terminal_trace(env,rid):
        deadline=monotonic()+10
        trace=env.trace(rid)
        while trace['status'] not in {'completed','failed','canceled'} and monotonic()<deadline:
            sleep(.1)
            trace=env.trace(rid)
        return trace
    
    
