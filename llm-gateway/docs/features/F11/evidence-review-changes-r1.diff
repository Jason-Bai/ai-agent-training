+
+@pytest.mark.parametrize('field', ['max_requests', 'max_requests_per_agent'])
+@pytest.mark.parametrize('value', [0, -1, True, '2', 1.5, None])
+def test_invalid_limit_types_and_values_fail(tmp_path, field, value):
