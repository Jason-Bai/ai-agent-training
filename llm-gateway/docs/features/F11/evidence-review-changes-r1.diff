+        await counts(env, {'active_requests':1, 'agents':{'a':1}})
+        release(env, rid)
+        checked = await verify_completion(env, await task, model)
+        await counts(env, {'active_requests':0, 'agents':{}})
+        later = await env.call(alternate, 'text')
