+@pytest.mark.parametrize('blocked', ['headers', 'response.delta', 'response.heartbeat',
+                                    'response.completed', 'response.failed'])
+async def test_actual_asgi_send_wait_is_inside_total_timeout(blocked, monkeypatch):
+    from providers.base import ProviderStreamEvent
+    from providers.mock import MockProvider
+    import services.streaming as streaming
+    monkeypatch.setattr(streaming, 'STREAM_HEARTBEAT_SECONDS', 0.01)
+    never = asyncio.Event()
+
+    async def wait_forever():
+        await never.wait()
+
+    script = ([wait_forever] if blocked == 'response.heartbeat' else
+              [ProviderStreamEvent(status='failed', error_code='provider_auth_error')] if blocked == 'response.failed' else
+              [ProviderStreamEvent(delta='正文'), ProviderStreamEvent(status='completed', upstream_terminal_received=True)])
+    provider = MockProvider(stream_events=script)
+    app = make_app(primary=provider)
+    body = json.dumps(request_body(timeout_seconds=1)).encode()
+    scope = {'type': 'http', 'method': 'POST', 'path': '/v1/llm/stream', 'raw_path': b'/v1/llm/stream',
+             'root_path': '', 'scheme': 'http', 'query_string': b'', 'http_version': '1.1',
+             'headers': [(b'content-type', b'application/json')], 'server': ('test', 80),
+             'client': ('127.0.0.1', 1234), 'asgi': {'version': '3.0', 'spec_version': '2.4'}}
+    received = False
+    active_send = 0
+    terminal_attempts = 0
+
+    async def receive():
+        nonlocal received
+        if not received:
+            received = True
+            return {'type': 'http.request', 'body': body, 'more_body': False}
+        await never.wait()
+
+    async def send(message):
+        nonlocal active_send, terminal_attempts
+        active_send += 1
+        assert active_send == 1
+        try:
+            name = 'headers' if message['type'] == 'http.response.start' else ''
+            if message.get('body'):
+                name = message['body'].decode().split('\n', 1)[0][7:]
+            if name in {'response.failed', 'response.completed'}:
+                terminal_attempts += 1
+            if name == blocked:
+                await never.wait()
+        finally:
+            active_send -= 1
+
+    async with asyncio.timeout(3):
+        await app(scope, receive, send)
+    trace = app.state.traces.requests[scope['state']['request_id']]
+    assert trace.status == 'failed' and trace.error_code == 'request_timeout'
+    assert len(provider.stream_calls) == trace.attempts == (0 if blocked == 'headers' else 1)
+    assert terminal_attempts <= 1 and active_send == 0
+    if trace.attempts:
+        assert provider.stream_close_calls == 1
+        attempt = app.state.traces.attempts[0]
+        assert attempt.status == 'failed'
+        if blocked == 'response.failed':
+            assert attempt.provider_error_code == 'provider_auth_error'
+
