+"""Encode platform events and expose actual ASGI sends to the executor."""
+import asyncio
+
+from starlette.responses import Response
+
+from utils.json_codec import dumps
+
+
+def encode_event(name, data):
+    return f'event: {name}\ndata: {dumps(data)}\n\n'.encode('utf-8')
+
+
+class EventStreamResponse(Response):
+    media_type = 'text/event-stream'
+
+    def __init__(self, execution, status_code: int = 200):
+        super().__init__(status_code=status_code, headers={'Cache-Control': 'no-cache', 'X-Accel-Buffering': 'no'})
+        del self.headers['content-length']
+        self.execution = execution
+
+    async def __call__(self, scope, receive, send):
+        disconnected = asyncio.Event()
+        scope['state']['stream_execution_owned'] = True
+
+        async def watch_disconnect():
+            while True:
+                message = await receive()
+                if message['type'] == 'http.disconnect':
+                    disconnected.set()
+                    return
+
+        async def start():
+            await send({'type': 'http.response.start', 'status': self.status_code, 'headers': self.raw_headers})
+
+        async def emit(name, data):
+            await send({'type': 'http.response.body', 'body': encode_event(name, data), 'more_body': True})
+
+        watcher = asyncio.create_task(watch_disconnect())
+        try:
+            await self.execution.run(start, emit, disconnected)
+            # A final empty transport frame is not the execution success signal.
+            if self.execution.started_response and not disconnected.is_set():
+                remaining = self.execution.deadline - asyncio.get_running_loop().time()
+                if remaining > 0:
+                    async with asyncio.timeout(remaining):
+                        await send({'type': 'http.response.body', 'body': b'', 'more_body': False})
+        except (OSError, TimeoutError):
+            pass
+        finally:
+            watcher.cancel()
+            await asyncio.gather(watcher, return_exceptions=True)
