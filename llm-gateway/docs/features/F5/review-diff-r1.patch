+            if line:
+                frame.append(line)
+                continue
+            if not frame:
+                continue
+            assert len(frame)==2 and frame[0].startswith('event: ') and frame[1].startswith('data: ')
+            name=frame[0][7:];data=json.loads(frame[1][6:]);frame=[]
